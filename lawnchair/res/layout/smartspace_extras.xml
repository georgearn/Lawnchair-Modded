<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/alarm_icon"
        android:layout_width="@dimen/enhanced_smartspace_icon_size"
        android:layout_height="@dimen/enhanced_smartspace_icon_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <app.lawnchair.smartspace.DoubleShadowTextView
        android:id="@+id/alarm_text"
        style="@style/EnhancedSmartspaceTextSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/dnd_icon"
        android:layout_width="@dimen/enhanced_smartspace_icon_size"
        android:layout_height="@dimen/enhanced_smartspace_icon_size"
        android:layout_gravity="center_vertical"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/media_controls_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/media_previous"
            android:layout_width="@dimen/enhanced_smartspace_media_button_size"
            android:layout_height="@dimen/enhanced_smartspace_media_button_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_previous"
            android:contentDescription="@string/media_previous" />

        <ImageButton
            android:id="@+id/media_play_pause"
            android:layout_width="@dimen/enhanced_smartspace_media_button_size"
            android:layout_height="@dimen/enhanced_smartspace_media_button_size"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_pause"
            android:contentDescription="@string/media_play_pause" />

        <ImageButton
            android:id="@+id/media_next"
            android:layout_width="@dimen/enhanced_smartspace_media_button_size"
            android:layout_height="@dimen/enhanced_smartspace_media_button_size"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_next"
            android:contentDescription="@string/media_next" />
    </LinearLayout>
</merge>

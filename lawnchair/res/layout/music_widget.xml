<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/music_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/music_widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/music_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/music_widget_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/music_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/music_widget_accent"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/music_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/music_widget_track"
        android:progressTint="@color/music_widget_accent"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/music_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/media_button_ripple"
            android:contentDescription="@string/smartspace_media_previous"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_previous"
            android:tint="@color/music_widget_text" />

        <ImageView
            android:id="@+id/music_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/music_widget_play_background"
            android:contentDescription="@string/smartspace_media_play_pause"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_play"
            android:tint="@color/music_widget_on_accent" />

        <ImageView
            android:id="@+id/music_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/media_button_ripple"
            android:contentDescription="@string/smartspace_media_next"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_next"
            android:tint="@color/music_widget_text" />
    </LinearLayout>
</LinearLayout>

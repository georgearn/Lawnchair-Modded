<?xml version="1.0" encoding="utf-8"?>
<app.lawnchair.smartspace.BcSmartspaceCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingEnd="@dimen/enhanced_smartspace_margin_start_launcher"
    android:baselineAligned="false">

    <include
        layout="@layout/smartspace_title_subtile_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

    <LinearLayout
        android:id="@+id/media_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/media_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/media_button_ripple"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/smartspace_media_previous"
            android:src="@drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/media_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/media_button_ripple"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/smartspace_media_play_pause"
            android:src="@drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/media_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/media_button_ripple"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/smartspace_media_next"
            android:src="@drawable/ic_media_next" />
    </LinearLayout>
</app.lawnchair.smartspace.BcSmartspaceCard>
